<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.*?>


<AnchorPane prefHeight="600.0" prefWidth="1200.0"
    style="-fx-background-color: linear-gradient(to bottom, #6A0DAD, #4C0B80);"
            xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controller.GameController">
   <children>
  <Line startX="100.0" startY="510.0" endX="100.0" endY="450.0" stroke="#FFD700" strokeWidth="5.0" opacity="0.35" />
  <Circle centerX="90.0" centerY="520.0" radius="14.0" fill="#FFD700" opacity="0.35" />
  <Line startX="280.0" startY="180.0" endX="280.0" endY="110.0" stroke="#FFD700" strokeWidth="5.0" opacity="0.35" />
  <Circle centerX="268.0" centerY="190.0" radius="14.0" fill="#FFD700" opacity="0.35" />
  <Line startX="510.0" startY="500.0" endX="510.0" endY="430.0" stroke="#FFD700" strokeWidth="5.0" opacity="0.35" />
  <Circle centerX="500.0" centerY="510.0" radius="14.0" fill="#FFD700" opacity="0.35" />
  <Line startX="760.0" startY="210.0" endX="760.0" endY="140.0" stroke="#FFD700" strokeWidth="5.0" opacity="0.35" />
  <Circle centerX="748.0" centerY="220.0" radius="14.0" fill="#FFD700" opacity="0.35" />
  <Line startX="1020.0" startY="460.0" endX="1020.0" endY="390.0" stroke="#FFD700" strokeWidth="5.0" opacity="0.35" />
  <Circle centerX="1008.0" centerY="470.0" radius="14.0" fill="#FFD700" opacity="0.35" />

      <Label fx:id="chordLabel"
       layoutX="450.0"
       layoutY="125.0"
       prefHeight="50.0"
       prefWidth="300.0"
       text="Note"
       alignment="CENTER"
       style="-fx-text-fill: #FFD700; -fx-font-size: 32px; -fx-font-weight: bold;" />
   <Label fx:id="scoreLabel" layoutX="400" layoutY="25" prefHeight="114.0" prefWidth="150.0" text="Score: 0"
          style="-fx-text-fill: #FFD700;">

            <font>
                <Font size="36.0" />
            </font>
   </Label>
       <Label text="Time:" fx:id="countDownLabel" layoutX="600" layoutY="25" prefHeight="114.0" prefWidth="200.0"
             style="-fx-text-fill: #FFD700;">
           <font>
               <Font size="36.0"/>
           </font>
       </Label>
           <Button fx:id="pauseButton" layoutX="850.0" layoutY="45.0" prefHeight="40.0" prefWidth="80.0" text="Pause"
               style="-fx-background-color: #FFD700; -fx-text-fill: #6A0DAD; -fx-font-weight: bold; -fx-background-radius: 6; -fx-font-size: 14px;"
               onAction="#handleMenuAction" />
       <Button layoutX="940.0" layoutY="45.0" prefHeight="40.0" prefWidth="80.0" text="Tips"
               style="-fx-background-color: #FFD700; -fx-text-fill: #6A0DAD; -fx-font-weight: bold; -fx-background-radius: 6; -fx-font-size: 14px;"
               onAction="#handleTipsAction" />
       <Button layoutX="1030.0" layoutY="45.0" prefHeight="40.0" prefWidth="80.0" text="Quit"
               style="-fx-background-color: #FF4444; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 6; -fx-font-size: 14px;"
               onAction="#handleQuitAction" />


         <ImageView fx:id="noteView" fitHeight="400.0" fitWidth="800.0" layoutX="200.0" layoutY="107.0" pickOnBounds="true" preserveRatio="true" />
         <ImageView fx:id="feedbackView" fitHeight="125.0" fitWidth="125.0" layoutX="1000.0" layoutY="250.0" preserveRatio="true" />
   </children>
</AnchorPane>
