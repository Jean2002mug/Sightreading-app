<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20; -fx-background-color: #6A0DAD;"
      xmlns="http://javafx.com/javafx/17.0.2-ea"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.controller.QuitConfirmationController">
    <children>
        <Label text="Are you sure you want to quit?"
               style="-fx-text-fill: #FFD700; -fx-font-size: 18px; -fx-font-weight: bold; -fx-alignment: CENTER;" />
        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="confirmButton" text="Yes, Quit" prefWidth="100.0"
                style="-fx-background-color: #FF4444; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 6;"
                onAction="#confirmQuit" />
            <Button fx:id="cancelButton" text="Cancel" prefWidth="100.0"
                style="-fx-background-color: #FFD700; -fx-text-fill: #6A0DAD; -fx-font-weight: bold; -fx-background-radius: 6;"
                onAction="#cancelQuit" />
        </HBox>
    </children>
</VBox>
