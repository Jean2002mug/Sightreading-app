<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane  xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controller.SettingsPageController"
            style="-fx-background-color: #5A189A;">

    <top>
        <VBox style="-fx-padding: 24;">
            <Label text="Settings"
                   style="-fx-font-size: 34px; -fx-font-weight: 800; -fx-text-fill: #FFD700;"/>
        </VBox>
    </top>

    <center>
       <ScrollPane fitToWidth="true"
            style="
                -fx-background: #5A189A;
                -fx-background-color: #5A189A;
                -fx-control-inner-background: #5A189A;
                -fx-border-color: transparent;">
           <VBox spacing="20"
                style="
                    -fx-padding: 30;
                    -fx-alignment: TOP_CENTER;
                    -fx-background-color: #5A189A;">
                <VBox spacing="15" style="-fx-padding: 22; -fx-background-color: rgba(255,255,255,0.06);">
                    <Label text="Input Mode"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FFD700;"/>

                    <fx:define>
                        <ToggleGroup fx:id="inputModeGroup"/>
                    </fx:define>

                    <HBox spacing="15">
                        <RadioButton fx:id="autoDetectRadio"
                                     text="Auto Detect (MIDI or Keyboard)"
                                     selected="true"
                                     toggleGroup="$inputModeGroup"
                                     style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px;"/>

                        <RadioButton fx:id="midiRadio"
                                     text="MIDI Keyboard Only"
                                     toggleGroup="$inputModeGroup"
                                     style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px;"/>

                        <RadioButton fx:id="computerKeyboardRadio"
                                     text="Computer Keyboard Only"
                                     toggleGroup="$inputModeGroup"
                                     style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px;"/>
                    </HBox>

                    <Separator/>

                    <Label fx:id="midiStatusLabel"
                           text="MIDI Device Status: Not Connected"
                           style="-fx-text-fill: #FFD700; -fx-font-size: 13px;"/>

                    <Button text="Detect MIDI Device"
                            onAction="#detectMidiDevice"
                            style="-fx-background-color: #4B0082; -fx-text-fill: #FFD700; -fx-font-weight: 700;"/>
                </VBox>

                <VBox spacing="15" style="-fx-padding: 22;-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12;">
                    <Label text="Computer Keyboard Mapping (QWERTY)"
                           style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #FFD700;"/>

                    <GridPane hgap="20" vgap="10" style="-fx-padding: 10;">
                        <Label text="A = C" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label text="W = C#" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="S = D" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label text="E = D#" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="D = E" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label text="F = F" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="T = F#" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label text="G = G" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                        <Label text="Y = G#" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label text="H = A" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="U = A#" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                        <Label text="J = B" style="-fx-text-fill: #FFFFFF;" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                    </GridPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="20" style="-fx-padding: 18; -fx-alignment: CENTER;">
            <Button text="Save"
                    onAction="#saveSettings"
                    style="-fx-background-color: #FFD700; -fx-text-fill: #4B0082; -fx-font-weight: 800;"/>

            <Button text="Back"
                    onAction="#goBack"
                    style="-fx-background-color: transparent; -fx-text-fill: #FFD700; -fx-border-color: #FFD700; -fx-border-width: 2;"/>
        </HBox>
    </bottom>

</BorderPane>